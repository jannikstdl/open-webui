pipeline {
  agent {
    kubernetes {
      label 'kaniko-builder'
      defaultContainer 'jnlp'
      yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins-kaniko-sa
  restartPolicy: Never
  containers:
  - name: kaniko
    image: gcr.io/kaniko-project/executor:debug
    command: ["sleep"]
    args: ["infinity"]
    volumeMounts:
      - name: kaniko-secret
        mountPath: /kaniko/.docker
  volumes:
    - name: kaniko-secret
      secret:
        secretName: gitlab-imagerepo-test-secret
"""
    }
  }

  environment {
    REGISTRY = 'registry.fits.cloud/fits-ai-services/fits-test'
    APP = 'fits-test'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Set variables') {
      steps {
        script {
          env.COMMIT = sh(returnStdout: true, script: 'git rev-parse --short=8 HEAD').trim()
          env.IMAGE_TAG = env.COMMIT
          env.IMAGE = "${env.REGISTRY}/${env.APP}:${env.IMAGE_TAG}"
          echo "Will build ${env.IMAGE}"
          }
      }
    }

    stage('Build & Push Docker Image') {
      steps {
        container('kaniko') {
          sh """
          /kaniko/executor \
            --dockerfile=Dockerfile \
            --context=dir://. \
            --destination=env.IMAGE \
            --verbosity=debug
          """
        }
      }
    }

    stage('Scan image (Trivy)') {
      steps {
        container('kaniko') {
          sh 'echo "Hier Trivy scan einbauen (Container starten und --input env.IMAGE)"'
        }
      }
    }

    stage('Notify / Set output') {
      steps {
        echo "Image pushed: env.IMAGE"
        writeFile file: 'image.txt', text: IMAGE
        archiveArtifacts artifacts: 'image.txt', onlyIfSuccessful: true
      }
    }
  }

  post {
    success {
      echo "Build erfolgreich: env.IMAGE"
    }
    failure {
      echo "Build fehlgeschlagen"
    }
  }
}